# Create a project at https://supabase.com, then run supabase/schema.sql
# in its SQL editor. Copy this file to .env.local and fill these in from
# Project Settings -> API in your Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: powers the Agent tab's fast/complex task routing via Jev
# (TypeSafe AI) through the Vercel AI Gateway. Generated from the Vercel
# dashboard -> AI Gateway. Without it, the Agent tab falls back to a
# keyword heuristic - everything still works, just less accurately.
AI_GATEWAY_API_KEY=
